{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verification Workbench",
  "version": "0.1.0",
  "identifier": "dev.verification.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Verification Workbench", "width": 1500, "height": 960, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173" }
  },
  "bundle": { "active": false, "icon": [] }
}
