{
  "name": "verification-workbench",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && node scripts/bundle-team.mjs",
    "package:windows": "tauri build --ci --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:team:e2e": "playwright test --config playwright.team.config.ts",
    "serve:lan": "node server/index.ts",
    "serve:game-fixture": "node scripts/serve-game-fixture.mjs",
    "verify:blackbox": "node scripts/verify-blackbox.mjs",
    "verify:game-agent": "node scripts/verify-game-agent.mjs",
    "verify:workflow": "cargo build -p execution-runtime --example local --locked && vitest run --config vitest.workflow.config.ts",
    "format:check": "prettier --check src server scripts tests/e2e tests/runtime *.ts package.json tsconfig.json",
    "format": "prettier --write src server scripts tests/e2e tests/runtime *.ts package.json tsconfig.json",
    "version:check": "node scripts/version.mjs && node --test scripts/version-contracts.mjs",
    "version:set": "node scripts/version.mjs",
    "check": "npm run version:check && npm run format:check && npm run check:constraints && npm run test && npm run build",
    "check:constraints": "node scripts/check-constraints.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "12.12.0",
    "ajv": "^8.17.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rolldown": "1.2.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
